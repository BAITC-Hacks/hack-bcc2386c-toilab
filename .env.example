# Copy to .env in the repository root. Never commit real credentials.
CATALOG_MODE=demo
PARTNER_API_URL=https://ekt.kz/api
PARTNER_API_USER=
PARTNER_API_PASSWORD=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
INTERNAL_API_TOKEN=
PUBLIC_CATALOG_URL=http://localhost:8001
ASSISTANT_SERVICE_URL=http://localhost:8002
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SYNC_INTERVAL=300

# START_LOCAL_AI.cmd configures Ollama automatically; these defaults preserve cloud mode.
LLM_PROVIDER=openai
OLLAMA_URL=http://127.0.0.1:11434
